# Пример окружения «Города+». Скопируйте в .env и заполните.
# Никакие реальные токены и пароли в репозиторий не попадают.

# ============================================================
# Telegram (обязательно)
# ============================================================
# Получите токен у @BotFather и храните только в .env
BOT_TOKEN=
ADMIN_IDS=
# Прокси для api.telegram.org — нужен, если Telegram недоступен напрямую
# (иначе запуск падает с TelegramNetworkError: Request timeout error).
# Примеры: http://127.0.0.1:3128, http://user:pass@host:3128,
#          socks5://127.0.0.1:1080 (для socks нужен пакет aiohttp_socks).
#BOT_PROXY=socks5://127.0.0.1:10808
# Транспорт до api.telegram.org: auto (по умолчанию), direct или proxy.
# auto: сначала прямое соединение — обычный системный VPN (WireGuard/OpenVPN/
#       VPN-клиент Windows) маршрутизирует трафик сам, боту настройка не нужна;
#       если напрямую не выходит, используется BOT_PROXY.
# direct: всегда напрямую, BOT_PROXY игнорируется.
# proxy:  только через BOT_PROXY (ошибка, если прокси недоступен).
BOT_TRANSPORT=auto
# Если прокси недоступен — продолжать без него (предупреждение в лог).
# Поставьте false, чтобы падать с ProxyUnavailableError вместо тихого обхода.
BOT_PROXY_FALLBACK_DIRECT=true
# Таймаут одного запроса к Telegram в секундах (по умолчанию 60).
BOT_REQUEST_TIMEOUT=60

# ============================================================
# База данных
# ============================================================
# Локальный запуск без сервера БД:
#ATABASE_URL=sqlite+aiosqlite:///./data/cities_bot.db
# Продакшен с PostgreSQL в Docker:
DB_HOST=
DB_PORT=
DB_NAME=
 DB_USER=
DB_PASSWORD=

# ============================================================
# Redis (необязательно)
# ============================================================
# Пусто — используются InMemoryRedis и MemoryStorage (один процесс).
REDIS_URL=
FSM_REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
# FSM_REDIS_URL=redis://localhost:6379/1

# ============================================================
# Бесплатные API без ключей (работают по умолчанию)
# ============================================================
NOMINATIM_URL=https://nominatim.openstreetmap.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WIKIPEDIA_BASE_URL=https://ru.wikipedia.org/api/rest_v1
KARTAVIEW_BASE_URL=https://api.openstreetcam.org/2.0
REST_COUNTRIES_BASE_URL=https://restcountries.com/v3.1
PANORAMAX_BASE_URL=https://api.panoramax.xyz/api
FRANKFURTER_BASE_URL=https://api.frankfurter.app
MEMORY_BASE_URL=https://api.mymemory.translated.net
# Без ключа работают также: photon, open_meteo_geocoding, osm_maps, flagcdn,
# wikidata, dbpedia (ru), wikivoyage, wikipedia_ru, worldtimeapi,
# sunrise_sunset, exchangerate, exchange, nager_date, open_meteo_air,
# overpass, usgs_earthquake, nasa_apod (DEMO_KEY), world_bank, ipapi.

# ============================================================
# Провайдеры с ключами (необязательно, без ключа просто пропускаются)
# ============================================================
# Ключи «длинного хвоста» читаются из окружения по конвенции:
#   <NAME>_API_KEY, затем <NAME>_TOKEN, <NAME>_KEY, <NAME>_USERNAME
# (см. app/services/external/base.py::provider_key).
# Уже поддержаны в Settings:
GEONAMES_USERNAME=
OPENCAGE_API_KEY=
OPENWEATHER_API_KEY=
VISUAL_CROSSING_API_KEY=
MAPILLARY_TOKEN=
THUNDERFOREST_API_KEY=
STADIA_MAPS_API_KEY=
GOOGLE_STREETVIEW_API_KEY=
UNSPLASH_ACCESS_KEY=
LIBRETRANSLATE_URL=
# Остальные — по конвенции, примеры имён:
# POSITIONSTACK_API_KEY= GEOAPIFY_API_KEY= LOCATIONIQ_API_KEY=
# MAPBOX_API_KEY= MAPTILER_API_KEY= YANDEX_MAPS_API_KEY=
# WEATHERSTACK_API_KEY= TOMORROW_IO_API_KEY= WEATHERBIT_API_KEY=
# METEOSOURCE_API_KEY= ACCUWEATHER_API_KEY=
# PIXABAY_API_KEY= FLICKR_API_KEY= PEXELS_API_KEY=
# BING_MAPS_API_KEY= GOOGLE_TRANSLATE_API_KEY= DEEPL_API_KEY=
# YANDEX_TRANSLATE_API_KEY= TIMEZONEDB_API_KEY=
# OPEN_EXCHANGE_RATES_API_KEY= HOLIDAY_API_KEY= OPENAQ_API_KEY=
# AIRVISUAL_API_KEY= FOURSQUARE_API_KEY= OPENTRIPMAP_API_KEY= YELP_API_KEY=
# CARBON_INTERFACE_API_KEY= GNEWS_API_KEY= NEWSAPI_API_KEY=
# GUARDIAN_API_KEY= YOUTUBE_API_KEY= VIMEO_ACCESS_TOKEN=
# ABSTRACT_API_KEY= NASA_API_KEY=

# ============================================================
# Приложение
# ============================================================
LOG_LEVEL=INFO
ENVIRONMENT=development
DEFAULT_LOCALE=
CACHE_TTL_DEFAULT=3600
# Секунд на ход в режиме «Города» (0 — без ограничения по времени).
MOVE_TIMEOUT=60
USE_WEBHOOK=true
WEBHOOK_URL=
WEBHOOK_SECRET=
